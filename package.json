{
  "name": "wren-mcp",
  "version": "0.3.2",
  "private": true,
  "description": "Local stdio MCP server that lets an AI assistant read a Wren notes folder (Build with Baker).",
  "author": "Adam Baker / Build with Baker",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "wren-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.test.json",
    "build": "npm run typecheck && tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "pack": "npm run build && npm prune --omit=dev --no-save && npx @anthropic-ai/mcpb pack . Wren.mcpb && npm ci"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^20.14.0",
    "eslint": "^10.11.0",
    "globals": "^15.12.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
